{
  "name": "kids-museum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "node tools/run-supabase-integration.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test --project=preview",
    "e2e:preview": "playwright test --project=preview",
    "e2e:supabase": "node tools/run-supabase-e2e.mjs",
    "ai:mock": "node tools/local-ai-mock.mjs",
    "local:bootstrap": "node tools/bootstrap-local.mjs",
    "local:bootstrap:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\bootstrap-local.ps1",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:setup": "node tools/setup-local-resources.mjs",
    "supabase:db:reset": "supabase db reset",
    "supabase:reset": "supabase db reset && node tools/setup-local-resources.mjs",
    "supabase:stop": "supabase stop",
    "docker:up": "docker compose --env-file .env.local -f compose.local.yml up --build -d",
    "docker:preview": "docker compose --env-file .env.local -f compose.local.yml up --build -d preview",
    "docker:down": "docker compose --env-file .env.local -f compose.local.yml down",
    "docker:logs": "docker compose --env-file .env.local -f compose.local.yml logs -f web ai-mock",
    "cleanup:media": "node tools/run-media-cleanup.mjs",
    "preflight:deploy": "node tools/preflight-deploy.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "archiver": "^8.0.0",
    "lucide-react": "^1.28.0",
    "music-metadata": "^11.14.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
