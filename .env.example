# Local bootstrap writes real local-only values to ignored .env.local.
# Never commit an anon/publishable key or service-role/secret key here.
# `npm run preflight:deploy` checks that production values are present without printing them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<from-supabase-status>
# Optional server-only URL for an application running inside Docker.
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# Safe defaults for `npm.cmd run ai:mock`; replace only in .env.local for cloud AI.
OPENAI_API_KEY=local-mock-only
OPENAI_BASE_URL=http://127.0.0.1:4010/v1
OPENAI_VISION_MODEL=kids-museum-local-mock
OPENAI_TRANSCRIPTION_MODEL=kids-museum-local-transcribe
